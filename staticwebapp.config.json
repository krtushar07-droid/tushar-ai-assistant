{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/logout", "redirect": "/.auth/logout?post_logout_redirect_uri=/" },
    { "route": "/*", "allowedRoles": ["authenticated"] }
  ],
  "responseOverrides": {
    "401": { "statusCode": 302, "redirect": "/.auth/login/github?post_login_redirect_uri=/" }
  }
}
